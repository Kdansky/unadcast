# Copy to .env, fill it in, then run bin/install. Rerun bin/install after any change here.

# --- Which machine does what ---
# Processing (finding and cutting ads) needs an NVIDIA GPU. "yes" if this machine does it, "no" if it only serves.
PROCESS=yes
# Serving (feeds, audio and the admin page, for your podcast app) is best on a machine that is always on.
# Empty: this machine. Otherwise the ssh host of the machine that serves (user@host, or a name from ~/.ssh/config);
# bin/install sets it up over ssh. It needs Docker, and a NAS share (below) that both machines reach.
SERVE_HOST=
# How your phone reaches the serving machine, e.g. http://192.168.1.20:8765. Empty: worked out from its address.
UNADCAST_SERVER=
# The port it serves on.
UNADCAST_PORT=8765

# --- Where processed episodes are kept ---
# Empty: in data/public on this machine. To keep them on a NAS instead, its SMB share:
NAS_ADDR=
NAS_SHARE=
NAS_USER=
NAS_PASSWORD=
# Optional: a read-only NAS user for the serving machine. Empty: it uses NAS_USER.
NAS_SERVE_USER=
NAS_SERVE_PASSWORD=
# SMB dialect: 3.0 unless the NAS is set to a lower maximum (Synology DSM: File Services > SMB > Advanced).
NAS_SMB=3.0

# --- Processing ---
# Hours between passes nobody asked for; 0 = only when "Process now" is pressed.
UNADCAST_EVERY=12
# Postpone a wanted pass by an hour while something else (a game) uses this percentage of the GPU's memory.
UNADCAST_GPU_BUSY=50
